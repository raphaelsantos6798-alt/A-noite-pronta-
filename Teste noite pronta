          </div>
        ))}
      </div>
    </div>
  );
};

const btnStyle = { marginRight: '10px', padding: '8px 15px', cursor: 'pointer', border: 'none', borderRadius: '4px', backgroundColor: '#007bff', color: '#fff' };

export default PainelCozinha;
import { createClient } from '@supabase/supabase-js'

// Essas chaves você pega no painel do Supabase (Settings > API)
const supabaseUrl = 'SUA_URL_DO_SUPABASE'
const supabaseAnonKey = 'SUA_CHAVE_ANON_KEY'

export const supabase = createClient(supabaseUrl, supabaseAnonKey)
async function validarCupom(codigoCupom) {
  // Busca o nutri que tem aquele cupom específico
  const { data: nutri, error } = await supabase
    .from('prescritores')
    .select('*')
    .eq('cupom', codigoCupom.toUpperCase())
    .single();

  if (error || !nutri) {
    return { valido: false, mensagem: "Cupom não encontrado" };
  }

  return { valido: true, nutriId: nutri.id, desconto: 0.15 }; // 15% de desconto
}
async function finalizarVenda(dadosDoPedido, codigoCupom) {
  let idDoNutri = null;
  let valorFinal = dadosDoPedido.valorOriginal;

  // 1. Verifica se tem cupom e aplica a regra
  if (codigoCupom) {
    const validacao = await validarCupom(codigoCupom);
    if (validacao.valido) {
      idDoNutri = validacao.nutriId;
      valorFinal = valorFinal * (1 - validacao.desconto); // Aplica os 15%
    }
  }

  // 2. Salva no banco de dados
  const { data, error } = await supabase
    .from('pedidos')
    .insert([
      { 
        cliente: dadosDoPedido.cliente, 
        prato: dadosDoPedido.prato, 
        valor_total: valorFinal,
        taxa_plataforma: valorFinal * 0.20, // Seus 20%
        prescritor_id: idDoNutri, // O "rastro" do nutricionista
        cozinha_id: dadosDoPedido.cozinhaId
      }
    ]);

  if (!error) {
    console.log("Venda registrada! Nutri vinculado e 20% garantidos.");
  }
}
