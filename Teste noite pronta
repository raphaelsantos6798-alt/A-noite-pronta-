const express = require('express');
const app = express();
app.use(express.json());

// Simulação de Banco de Dados de Pedidos
let pedidos = [];

// Rota para criar um novo pedido (vindo do seu site)
app.post('/novo-pedido', (req, res) => {
    const { cliente, prato, valor, cozinhaId, nutriId } = req.body;

    const novoPedido = {
        id: pedidos.length + 1,
        cliente,
        prato,
        valorBruto: valor,
        taxaPlataforma: valor * 0.20, // Seus 20%
        valorCozinha: valor * 0.80,   // O que sobra para a cozinheira
        status: 'Pendente',
        data: new Date().toISOString()
    };

    pedidos.push(novoPedido);
    res.status(201).json({ message: "Pedido enviado para a Noite Pronta!", pedido: novoPedido });
});

// Rota para a cozinheira ver os pedidos dela
app.get('/pedidos-cozinha/:id', (req, res) => {
    const filtrados = pedidos.filter(p => p.cozinhaId === parseInt(req.params.id));
    res.json(filtrados);
});

app.listen(3000, () => console.log("Servidor Noite Pronta rodando na porta 3000"));
import React, { useState } from 'react';

const PainelCozinha = () => {
